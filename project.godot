; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Wrecking Crew"
config/description="Steer a demolition rig; the wrecking ball swings a second behind you. Aim it."
run/main_scene="res://src/game/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[autoload]

; Records and replays touch input for filmed runs (scripts/movie.ps1). Inert
; without a user arg - it reads OS.get_cmdline_user_args() in _ready and sets
; physics processing off unless `replay=` was passed. Registered here because
; the script alone does nothing: an autoload that is not in this file is a tool
; that can never run, which is the fault the audit found in rects.gd.
ReplayPlayer="*res://scripts/replay_player.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
